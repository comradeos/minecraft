# Container
CONTAINER_NAME=minecraft
SERVER_IMAGE=itzg/minecraft-server:latest

# Server type and version
SERVER_TYPE=VANILLA
MC_VERSION=26.2

# Server identity
SERVER_NAME=IO Minecraft Server
MOTD=IO Minecraft Server
EULA=TRUE
ONLINE_MODE=TRUE

# Networking
SERVER_PORT=25565

# Storage
DATA_DIR=./data

# Resources
MEMORY=4G
MAX_PLAYERS=10
VIEW_DISTANCE=10
TZ=Europe/Kyiv

# Gameplay
GAMEMODE=survival
DIFFICULTY=normal
PVP=TRUE
ENABLE_WHITELIST=FALSE
ALLOW_NETHER=TRUE
SPAWN_PROTECTION=16

# Optional loader-specific settings
# Leave blank unless your selected SERVER_TYPE needs them.
FORGE_VERSION=
NEOFORGE_VERSION=
FABRIC_LOADER_VERSION=
QUILT_LOADER_VERSION=
PAPER_CHANNEL=
